CREATE TABLE imfor_events_YTD AS (
  SELECT
    e.eventid,
    e.dateoffsetbegin::date AS "date",
    e.createdbycommitteename AS "committee",
    l.city,
    l.state,
    e.eventname,
    e.eventdescription
  FROM
    vansync.ppfa_events_mym e
    LEFT JOIN vansync.ppfa_eventslocations_mym loc USING (eventid)
    LEFT JOIN vansync.ppfa_locations_mym l USING (locationid)
    LEFT JOIN vansync.ppfa_eventscodes_mym ec USING (eventid)
  WHERE
    ec.codeid IN (1015656, 1016813, 1019521)
    AND EXTRACT(YEAR FROM(e.dateoffsetbegin)= 2026
    AND e.dateoffsetbegin < CURRENT_DATE
  ORDER BY
    1
);

CREATE TEMP TABLE closed_shifts_YTD AS (
  SELECT
    e.eventid,
    e.dateoffsetbegin::date AS "date",
    e.createdbycommitteename AS "committee",
    l.city,
    l.state,
    e.eventname,
    e.eventdescription,
    es.eventsignupid,
    ess.eventstatusname
  FROM
    vansync.ppfa_events_mym e
    LEFT JOIN vansync.ppfa_eventslocations_mym loc USING (eventid)
    LEFT JOIN vansync.ppfa_locations_mym l USING (locationid)
    LEFT JOIN vansync.ppfa_eventscodes_mym ec USING (eventid)
    LEFT JOIN vansync.ppfa_eventsignups_mym es USING (eventid)
    LEFT JOIN vansync.ppfa_eventsignupsstatuses_mym ess USING (eventsignupid)
  WHERE
    ec.codeid IN (1015656, 1016813, 1019521)
    AND  EXTRACT(YEAR FROM(e.dateoffsetbegin)= 2026
    AND ess.eventstatusname IN ('Completed', 'Walk In')
  ORDER BY
    1
);

CREATE TABLE reporting.imfor_total_signups_ytd_26
AS
SELECT
  e.committee,
    l.state,
   l.city,
  COUNT(DISTINCT e.eventid) AS total_events,
  COUNT(DISTINCT shifts.eventsignupid) AS closed_shifts
FROM
  imfor_events_YTD e
  LEFT JOIN closed_shifts_YTD shifts USING (eventid)
      LEFT JOIN vansync.ppfa_locations_mym l USING (locationid)
GROUP BY
  1,2,3
ORDER BY
  1;

DROP TABLE IF EXISTS reporting.imfor_program_ytd_26;
CREATE TABLE reporting.imfor_program_ytd_26
AS
SELECT
    com.committeename as committee
    CASE
        WHEN cc.codeid = 4153016 THEN 'Patient Advocacy'
        WHEN cc.codeid = 69342   THEN 'PP Generation Action'
        WHEN cc.codeid = 4266967 THEN 'Raiz'
        WHEN cc.codeid = 4471736 THEN 'Black Organizing'
        ELSE 'Other'
    END AS program,
    COUNT(DISTINCT cc.vanid) AS contacts
FROM 
    vansync.ppfa_contactscodes_mym cc
    JOIN vansync.ppfa_contacts_mym_cont c ON cc.vanid = c.vanid
    JOIN vansync.ppfa_committees com ON com.committeeid = cc.committeeid
WHERE 
    EXTRACT(YEAR FROM cc.datecreated) = 2026
GROUP BY 
    cc.committeeid,
    CASE
        WHEN cc.codeid = 4153016 THEN 'Patient Advocacy'
        WHEN cc.codeid = 69342   THEN 'PP Generation Action'
        WHEN cc.codeid = 4266967 THEN 'Raiz'
        WHEN cc.codeid = 4471736 THEN 'Black Organizing'
        ELSE 'Other'
    END;
    
-- Stories
DROP TABLE IF EXISTS reporting.im_for_stories_ytd_26;

CREATE TABLE reporting.im_for_stories_ytd_26 AS
SELECT
  com.committeename AS committee,
  cn.notecategoryname,
  COUNT(DISTINCT cn.contactsnoteid) AS total_count
FROM
  vansync.ppfa_contactsnotes_mym cn
  JOIN vansync.ppfa_contacts_mym_cont c USING (vanid)
  JOIN vansync.ppfa_contactsactivistcodes_mym s USING (vanid)
  JOIN vansync.ppfa_committees com ON com.committeeid = cn.committeeid
WHERE
  cn.datecreated >= '2026-01-01'
  AND s.activistcodeid = 4179673 -- Share Story
  AND cn.notecategoryname NOT IN ('COG Stories', 'Convio: Import Source','COVID-19','PPFA Online Storybank', 'Segment','Convio: Import Source' )
GROUP BY
  1,2;

--- Calls to Leg
create temporary table c2c as 
select datecanvassed::date,
com.committeename  as "committee", 
'Members Called' as "metric", 
d.state,
concat(d.state,d.congressionaldistrict),
tar.rep_name, 
count(distinct contactscontactid) 
from vansync.ppfa_contactssurveyresponses_mym cr
join vansync.ppfa_committees com using(committeeid)
join vansync.ppfa_mymembersdwidlookup dwid using(vanid)
left join catalist_periodic_install.district d using(dwid)
where surveyquestionid=684453 and surveyresponseid=2692564
group by 1,2,3,4,5,6,7
union 
select created_at::date as datecanvassed, 
'Members Called' as "member_calls", 
c.state,
tar.cd, 
member as "rep_name",  
count(distinct id) 
from  strive.call_logs st 
left join aharpersmith.house_119_2026 tar on c.name=tar.rep_name and c.state=tar.state
where call_number_name ilike '%c2c%'
group by 1,2,3,4,5,6,7
;